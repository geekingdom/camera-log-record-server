# 单独数据库：./deploy-database.sh --init 自动生成密码和副本集密钥，然后编辑 .env.database。
# 可修改：对客户端公布的IPv4或DNS主机名；必须被API、节点和本机三个成员访问。
# 跨机部署请将两个地址改成数据库服务器实际内网IP。
DATABASE_HOST=127.0.0.1
DATABASE_BIND_IP=127.0.0.1
# 可修改：三成员同主机不同端口，不能重复；首次初始化后按拓扑迁移流程修改。
MONGO_PORT_1=27017
MONGO_PORT_2=27018
MONGO_PORT_3=27019
# 用户名可在空库部署前修改。密码/密钥由--init随机生成，示例占位值不能直接部署。
MONGO_ROOT_USERNAME=camera_admin
MONGO_ROOT_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
MONGO_REPLICA_KEY=REPLACE_WITH_GENERATED_REPLICA_KEY
# 可修改：各成员分别使用独立绝对路径，如/srv/camera-logs/mongo1、mongo2、mongo3。
# 默认命名卷。首次部署会在隔离容器网络内为每个空卷预置管理员，再启动 host 网络成员；三成员不可共用目录。已有数据、密码、密钥须成套备份，重复执行不会覆盖。
MONGO_DATA_1=mongo1-data
MONGO_DATA_2=mongo2-data
MONGO_DATA_3=mongo3-data
# 常驻mongod均unless-stopped；初始化作业成功退出，不应持续重启。
# 三副本在一台主机仍不能抵御整台主机故障；这是本脚本明确的单机部署范围。
