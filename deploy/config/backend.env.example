# 单独后端：./deploy-backend.sh --init，然后编辑 .env.backend。
# 必填：三成员数据库地址；用户名/密码包含保留字符时须URL编码，authSource=admin。
MONGO_URI=mongodb://camera_admin:REPLACE_PASSWORD@192.0.2.10:27017,192.0.2.10:27018,192.0.2.10:27019/camera_logs?replicaSet=rs0&authSource=admin
DATABASE_NAME=camera_logs
# 必填：首次由部署脚本生成；已有数据库必须恢复原值；与所有采集节点完全一致。
ENCRYPTION_KEY=REPLACE_WITH_ORIGINAL_FERNET_KEY
BOOTSTRAP_TOKEN=REPLACE_WITH_ORIGINAL_BOOTSTRAP_TOKEN
INTERNAL_TOKEN=REPLACE_WITH_ORIGINAL_INTERNAL_TOKEN
# 可修改：默认127.0.0.1只接本机；分机前端需改为服务器内网IP或0.0.0.0。
API_BIND_IP=127.0.0.1
API_PORT=8000
# 可修改：可信前端代理实际源IP/CIDR，多个逗号分隔；分机不要使用*。
# 这决定X-Forwarded-For是否可信，与平台客户端IP白名单和设备目标IP是不同配置。
FORWARDED_ALLOW_IPS=127.0.0.1
# 可修改为/srv/camera-logs/api；服务日志位于service-logs/api，临时产物位于data。
API_DATA_ROOT=api-data
# 只对空库初始化；已修改管理员密码不会被重置。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=asdf!234
RETENTION_DAYS=7
SESSION_SECONDS=28800
SESSION_COOKIE_SECURE=false
