# 完整单机部署：./deploy-all.sh --init 后修改根 .env，再执行 ./deploy-all.sh
# 以下为可选覆盖项；ENCRYPTION_KEY/BOOTSTRAP_TOKEN/INTERNAL_TOKEN 由脚本生成，勿替换已有值。
# 前端对外端口，可修改；API 和数据库默认仅容器网络内可达。
FRONTEND_PORT=5175
# 后端容器内部服务端口；跨机前端代理和健康检查需使用同一端口。
API_PORT=18080
# Docker 构建 Python 依赖的源；公司部署默认使用公司制品库，外部构建环境可改为 https://pypi.org/simple。
PIP_INDEX_URL=http://af.hikvision.com.cn/artifactory/api/pypi/pypi/simple
PIP_TRUSTED_HOST=af.hikvision.com.cn
# 采集数据根目录，可改成绝对路径，例如 /srv/camera-logs/collector。
# 默认 worker-data 是 Docker 命名卷。容器内固定 /var/lib/camera-logs。
# 实际设备日志/小时归档在此根下 data/，服务运行日志在 service-logs/。
# 已有采集数据不会自动搬迁；改目录前停止对应节点并完整迁移原目录。
HOST_LOG_ROOT=worker-data
# 海康 coredump NFS 总目录；Worker 会按设备 IP 自动创建子目录。
NFS_ROOT=/srv/camera-logs/nfs-coredump
# 设备可达的宿主机IP；NFS服务和导出需部署后配置，不能填worker容器名称。
NFS_SERVER_IP=
# 后端服务运行日志与下载临时文件，可改为 /srv/camera-logs/api，不与采集目录共用。
API_DATA_ROOT=api-data
# 可修改：数据库各成员目录，三者必须不同。已有数据库目录不能随意更换。
MONGO_DATA_1=mongo1-data
MONGO_DATA_2=mongo2-data
MONGO_DATA_3=mongo3-data
# 默认保留天数（正整数）；平台已保存后台配置时以后台配置为准。
RETENTION_DAYS=7
# 认证历史默认保留90天（约三个月）；设为0表示关闭自动清理。其它增长型记录默认永久保留。
AUTHENTICATION_RECORD_RETENTION_DAYS=90
AUDIT_RECORD_RETENTION_DAYS=0
RUNTIME_EVENT_RETENTION_DAYS=0
COMMAND_HISTORY_RETENTION_DAYS=0
OPERATION_HISTORY_RETENTION_DAYS=0
# 单节点上限、集群上限，可按实际压测结果修改。
NODE_CAPACITY=100
CLUSTER_CAPACITY=500
# PSH 默认禁用。生产解密仅由 Worker 使用，以下凭据必须通过受限 .env 或密钥管理系统注入。
# PSH_MODE=http
# 默认分别为公开 OAuth/itapi 地址；公司代理可覆盖，URL 不得嵌入凭据。
# PSH_TOKEN_URL=https://hicode-auth-hz.hikvision.com/oauth/token
# PSH_API_URL=https://itapi.hikvision.com/api/
# PSH_CLIENT_ID=REPLACE_WITH_CLIENT_ID
# PSH_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# PSH_API_KEY=REPLACE_WITH_API_KEY
# PSH_USER_NAME=REPLACE_WITH_USER_NAME
# PSH_REQUEST_TIMEOUT_SECONDS=4
# PSH_TOTAL_TIMEOUT_SECONDS=9
# 节点ID稳定唯一；修改现有ID会被视作另一节点。
COLLECTOR_NODE_ID=compose-worker-1
# 完整部署保持此容器内部地址即可。
NODE_PORT=18081
COLLECTOR_NODE_URL=http://worker:${NODE_PORT}
# 只初始化空库，后续不会重置已修改的密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=asdf!234
# 完整单机与跨机 `deploy-all.sh --multi-host` 都使用下列认证数据库配置；部署器从实际密码生成内部 URI 或写回 URL 编码的 MONGO_URI，不能手工拼接。
# 密码含 $ 时使用单引号，例如 MONGO_ROOT_PASSWORD='p@:/?#$VALUE'，避免 Compose 展开宿主机变量。
MONGO_ROOT_USERNAME=camera_admin
MONGO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
