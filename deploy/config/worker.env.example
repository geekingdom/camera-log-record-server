# 单独采集节点：./deploy-worker.sh --init，然后编辑 .env.worker。
# 必填：与后端相同的数据库/库名/三项密钥；不能给节点重新生成不同密钥。
MONGO_URI=mongodb://camera_admin:REPLACE_PASSWORD@192.0.2.10:27017,192.0.2.10:27018,192.0.2.10:27019/camera_logs?replicaSet=rs0&authSource=admin
DATABASE_NAME=camera_logs
ENCRYPTION_KEY=REPLACE_WITH_BACKEND_FERNET_KEY
BOOTSTRAP_TOKEN=REPLACE_WITH_BACKEND_BOOTSTRAP_TOKEN
INTERNAL_TOKEN=REPLACE_WITH_BACKEND_INTERNAL_TOKEN
# 必填：稳定唯一ID，每台主机/每个节点不同；有日志后不能随意更换。
NODE_ID=collector-01
# 必填：后端可访问的节点HTTP地址，端口必须等于NODE_PORT。
NODE_URL=http://192.0.2.30:18081
# 可修改：节点监听端口/地址（Linux host网络，无端口映射）。
NODE_PORT=18081
NODE_BIND_IP=0.0.0.0
# Docker 构建依赖源；正式内网默认公司源，外部环境可改为公网 PyPI。
PIP_INDEX_URL=http://af.hikvision.com.cn/artifactory/api/pypi/pypi/simple
PIP_TRUSTED_HOST=af.hikvision.com.cn
# 可修改：宿主机日志根；推荐大容量独立磁盘，如/srv/camera-logs/collector-01。
# 默认worker-data命名卷；日志与归档在data/，服务日志在service-logs/。
# 本脚本仅初始化目录权限10001:10001，不递归修改已有日志，也不自动迁移旧目录。
HOST_LOG_ROOT=worker-data
# 海康 coredump NFS 总目录，建议使用宿主机绝对路径以便独立保存。
NFS_ROOT=/srv/camera-logs/nfs-coredump
# 设备可达的宿主机IP；NFS服务和导出需部署后配置，不能填worker容器名称。
NFS_SERVER_IP=
NODE_CAPACITY=100
RETENTION_DAYS=7
# 默认不校验设备指纹，按设备任务账户连接。此处不是平台访问IP白名单。
SSH_VERIFY_HOST_KEY=false
PSH_MODE=disabled
