# 环境变量示例；真实密钥与设备凭据放在忽略目录中。
MONGO_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/camera_logs?replicaSet=rs0
DATABASE_NAME=camera_logs
# 密钥生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY
BOOTSTRAP_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
INTERNAL_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
ADMIN_USERNAME=admin
# 用户约定的开发/正式初始密码；只初始化空库，首次登录强制改密。
ADMIN_PASSWORD=asdf!234
SESSION_SECONDS=28800
SESSION_COOKIE_SECURE=false
# 默认不校验 SSH 主机指纹，设备更换后仍按任务账号和密码登录。
SSH_VERIFY_HOST_KEY=false
# 严格模式才读取此文件：SSH_VERIFY_HOST_KEY=true
# KNOWN_HOSTS=.local/secrets/known_hosts
LOG_ROOT=data/logs
NODE_CAPACITY=100
CLUSTER_CAPACITY=500
RETENTION_DAYS=7
# PSH 调试默认关闭；本地 mock 文件必须位于忽略目录，HTTP 凭据由部署环境注入。
PSH_MODE=disabled
PSH_SERIAL_CHARACTER_INTERVAL=0.1
# PSH_MOCK_PASSWORD_FILE=.local/secrets/psh-passwords.json
# PSH_TOKEN_URL=https://your-auth-host/oauth/token
# PSH_API_URL=https://your-api-host/api/
# PSH_CLIENT_ID=REPLACE_WITH_CLIENT_ID
# PSH_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# PSH_API_KEY=REPLACE_WITH_API_KEY
# PSH_USER_NAME=REPLACE_WITH_USER_NAME
API_PORT=18080
FRONTEND_PORT=5175
NODE_URL=http://worker:18081
