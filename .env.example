# 环境变量示例；真实密钥、设备凭据与 known_hosts 放在忽略目录中。
MONGO_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/camera_logs?replicaSet=rs0
DATABASE_NAME=camera_logs
# 密钥生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY
BOOTSTRAP_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
INTERNAL_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
KNOWN_HOSTS=.local/secrets/known_hosts
LOG_ROOT=data/logs
NODE_CAPACITY=100
CLUSTER_CAPACITY=500
RETENTION_DAYS=7
API_PORT=8000
FRONTEND_PORT=5173
NODE_URL=http://worker:8001
